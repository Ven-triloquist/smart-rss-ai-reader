<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="4">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/navArticles"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:singleLine="true"
            android:text="Articles"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/navFeeds"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:singleLine="true"
            android:text="Feeds"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/navSummaries"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:singleLine="true"
            android:text="Summaries"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/navSettings"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:singleLine="true"
            android:text="Settings"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="Status: Ready"
        android:textSize="12sp" />

    <!-- Main Content Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Articles View -->
        <LinearLayout
            android:id="@+id/viewArticles"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnTabNew"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="New Articles" />

                <Button
                    android:id="@+id/btnTabRead"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Read Articles" />
            </LinearLayout>

            <!-- AI Action Bar with Selection Button -->
            <LinearLayout
                android:id="@+id/layoutAiBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <Button
                    android:id="@+id/btnSelectAllArticles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select All"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnSummarizeSelected"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Summarize (0)" />

                <Button
                    android:id="@+id/btnDebateSelected"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="AI Debate (0)" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerArticles"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <!-- Feeds View -->
        <LinearLayout
            android:id="@+id/viewFeeds"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/inputFeedUrl"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Enter RSS Feed URL"
                    android:inputType="textUri" />

                <Button
                    android:id="@+id/btnAddFeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add Feed" />
            </LinearLayout>

            <Button
                android:id="@+id/btnDiscoverFeeds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Discover Feeds by Country" />

            <ListView
                android:id="@+id/listFeeds"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <!-- Article Reader View -->
        <LinearLayout
            android:id="@+id/viewReader"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/btnBackToArticles"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Back to Articles" />

            <TextView
                android:id="@+id/readerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Reader Player Controls -->
            <LinearLayout
                android:id="@+id/readerMediaControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btnReaderRewind"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&lt;&lt;" />

                <Button
                    android:id="@+id/btnReaderPlayPause"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Play / Pause" />

                <Button
                    android:id="@+id/btnReaderFastForward"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&gt;&gt;" />

                <Button
                    android:id="@+id/btnReaderStop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stop" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/readerContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:textSize="15sp" />
            </ScrollView>
        </LinearLayout>

        <!-- Summaries View -->
        <LinearLayout
            android:id="@+id/viewSummaries"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <ListView
                android:id="@+id/listSummaries"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ScrollView
                android:id="@+id/scrollSummaryDetail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/btnBackToSummariesList"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Back to History" />

                    <TextView
                        android:id="@+id/summaryHeaderTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- Summary Player Controls -->
                    <LinearLayout
                        android:id="@+id/summaryMediaControls"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <Button
                            android:id="@+id/btnSummaryRewind"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="&lt;&lt;" />

                        <Button
                            android:id="@+id/btnSummaryPlayPause"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Play / Pause" />

                        <Button
                            android:id="@+id/btnSummaryFastForward"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="&gt;&gt;" />

                        <Button
                            android:id="@+id/btnSummaryStop"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Stop" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/summaryProgressBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/textSummaryOutput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="4dp"
                        android:textSize="15sp" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <!-- Settings View -->
        <ScrollView
            android:id="@+id/viewSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gemini API Key:"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/inputApiKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Paste your Gemini API key"
                    android:inputType="textPassword" />

                <Switch
                    android:id="@+id/switchAi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:text="Enable AI Features &amp; Selection" />

                <Switch
                    android:id="@+id/switchAutoMarkRead"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:text="Auto-mark articles as read on click" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="12dp"
                    android:text="Target AI &amp; TTS Language:"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerLanguage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="12dp"
                    android:text="Text-to-Speech Voice Engine:"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerTtsVoice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="12dp"
                    android:text="Read Article Retention Policy:"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerRetention"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="12dp"
                    android:text="Summary Depth/Length:"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerDepth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="12dp"
                    android:text="AI Debate Angle / Tone:"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerDebateTone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/btnSaveApiKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Save Settings" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
